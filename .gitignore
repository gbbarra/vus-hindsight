# Raw ClinVar snapshots — never committed (hundreds of MB each, re-fetchable)
*.txt.gz
*.txt
# Working data is disposable, EXCEPT the committed exports. Third-party
# predictor scores land in data/scores/ and stay ignored on purpose — most of
# them carry licences that forbid redistribution.
data/*
!data/exports/

# Generated test fixtures (rebuilt by tests/make_fixture.py on every run)
tests/fixtures/
*.vcf.gz
*.parquet

# DuckDB working databases
*.duckdb
*.duckdb.wal
.duckdb/

# Derived tables are ignored by default, EXCEPT the committed outputs
# under results/ (see negation below).
*.tsv
*.tsv.gz
!results/*.tsv
!results/*.tsv.gz
# The CI run log is committed as run provenance.
!results/*.txt

# Python
__pycache__/
*.pyc
.venv/

# Artefatos das ferramentas de qualidade (§4.6) — nenhum é fonte.
.coverage
coverage.json
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.mutmut-cache
mutants/
